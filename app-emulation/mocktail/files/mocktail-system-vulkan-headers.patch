Build against the system Khronos Vulkan headers.

third_party/Vulkan-Headers is a git submodule, so it is an empty directory in
the release tarball and add_subdirectory() fails outright.  dev-util/vulkan-headers
exports the very same Vulkan::Headers target through its CMake config package,
which is what mocktail_sdl_vulkan_wsi links against, so switching to
find_package() needs no further changes.

Upstream does the same substitution in packaging/aur/mocktail/PKGBUILD; this is
the patched form of that sed, kept versioned so it is reviewable.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -119,11 +119,7 @@
   target_compile_options(linker PRIVATE -w)
 endif()
 
-set(VULKAN_HEADERS_ENABLE_TESTS OFF CACHE BOOL
-  "Build Khronos Vulkan-Headers tests" FORCE)
-set(VULKAN_HEADERS_ENABLE_INSTALL OFF CACHE BOOL
-  "Install vendored Vulkan-Headers" FORCE)
-add_subdirectory(third_party/Vulkan-Headers EXCLUDE_FROM_ALL)
+find_package(VulkanHeaders CONFIG REQUIRED)
 
 include(CTest)
 if(BUILD_TESTING)
